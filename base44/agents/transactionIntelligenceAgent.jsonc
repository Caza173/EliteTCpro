{
  "name": "transactionIntelligenceAgent",
  "description": "EliteTC Transaction Superagent \u2014 reads transaction data, deadlines, tasks, communications, compliance, signatures, contacts, invoices, and notifications. Drafts addendums, composes emails, flags risks, and summarizes deal status. Does NOT recalculate deadlines or override app data.",
  "model": "automatic",
  "whatsapp_greeting": "",
