{
  "name": "WorkflowTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name"
    },
    "transaction_type": {
      "type": "string",
      "description": "buyer_under_contract | listing | dual | other"
    },
    "brokerage_id": {
      "type": "string",
      "description": "Brokerage-scoped template; null = system default"
    },
    "created_by": {
      "type": "string",
      "description": "User ID of creator"
    },
    "phases": {
      "type": "array",
      "description": "Ordered phase definitions with tasks",
      "items": {
        "type": "object",
        "properties": {
          "phase_num": {
            "type": "number"
          },
          "phase_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "default_checked": {
                  "type": "boolean"
                },
                "auto_generated": {
                  "type": "boolean"
                },
                "sort_order": {
                  "type": "number"
                },
                "trigger_type": {
                  "type": "string"
                },
                "trigger_offset": {
                  "type": "number"
                },
                "deadline_rule": {
                  "type": "string"
                },
                "auto_generate_date": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is the brokerage default template"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "transaction_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "owner",
            "super_admin"
          ]
        }
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "owner",
            "super_admin"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "owner",
            "super_admin"
          ]
        }
      }
    }
  }
}