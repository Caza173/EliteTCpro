{
  "name": "ScanJob",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string"
    },
    "brokerage_id": {
      "type": "string"
    },
    "triggered_by": {
      "type": "string",
      "description": "Email of user who triggered the scan"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "complete",
        "error"
      ],
      "default": "pending"
    },
    "total_docs": {
      "type": "number",
      "default": 0
    },
    "processed_docs": {
      "type": "number",
      "default": 0
    },
    "error_message": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    }
  },
  "required": [
    "transaction_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.transaction_id": {
            "$in": [
              "{{user.data.editable_tx_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "tc_lead",
                "tc"
              ]
            }
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.transaction_id": {
            "$in": [
              "{{user.data.accessible_tx_ids}}"
            ]
          }
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}",
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "tc_lead",
                "tc"
              ]
            }
          }
        },
        {
          "data.triggered_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.transaction_id": {
            "$in": [
              "{{user.data.editable_tx_ids}}"
            ]
          }
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}",
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "tc_lead",
                "tc"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "owner",
            "super_admin"
          ]
        }
      }
    }
  }
}