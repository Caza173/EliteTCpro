{
  "name": "DealExpense",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string"
    },
    "brokerage_id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "transaction_id",
    "category",
    "amount"
  ],
  "rls": {
    "create": {
      "data.brokerage_id": "{{user.data.brokerage_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "owner",
            "tc_lead",
            "tc",
            "agent"
          ]
        }
      }
    },
    "read": {
      "data.brokerage_id": "{{user.data.brokerage_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "owner",
            "tc_lead",
            "tc",
            "agent"
          ]
        }
      }
    },
    "update": {
      "data.brokerage_id": "{{user.data.brokerage_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "owner",
            "tc_lead",
            "tc",
            "agent"
          ]
        }
      }
    },
    "delete": {
      "data.brokerage_id": "{{user.data.brokerage_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "owner",
            "tc_lead",
            "tc"
          ]
        }
      }
    }
  }
}