{
  "name": "DealCollaborator",
  "type": "object",
  "properties": {
    "deal_id": {
      "type": "string",
      "description": "Reference to Transaction.id"
    },
    "user_id": {
      "type": "string",
      "description": "Reference to User.id"
    },
    "user_email": {
      "type": "string",
      "description": "Denormalized email for fast lookup"
    },
    "role": {
      "type": "string",
      "enum": [
        "viewer",
        "editor"
      ],
      "default": "viewer",
      "description": "Access level for this collaborator"
    },
    "added_by": {
      "type": "string",
      "description": "Email of the user who added this collaborator"
    },
    "brokerage_id": {
      "type": "string"
    }
  },
  "required": [
    "deal_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "data.brokerage_id": "{{user.data.brokerage_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "owner",
            "tc_lead",
            "tc"
          ]
        }
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner"
              ]
            }
          }
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        }
      ]
    },
    "update": {
      "data.brokerage_id": "{{user.data.brokerage_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "owner",
            "tc_lead",
            "tc"
          ]
        }
      }
    },
    "delete": {
      "data.brokerage_id": "{{user.data.brokerage_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "owner",
            "tc_lead"
          ]
        }
      }
    }
  }
}