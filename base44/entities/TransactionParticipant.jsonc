{
  "name": "TransactionParticipant",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string",
      "description": "Reference to Transaction"
    },
    "contact_id": {
      "type": "string",
      "description": "Reference to Contact"
    },
    "owner_user_id": {
      "type": "string",
      "description": "Owner of the parent transaction"
    },
    "role": {
      "type": "string",
      "enum": [
        "buyer",
        "seller",
        "lender",
        "attorney",
        "listing_agent",
        "buyer_agent"
      ],
      "default": "buyer"
    }
  },
  "required": [
    "transaction_id",
    "contact_id",
    "role"
  ],
  "rls": {
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "read": null,
    "update": null,
    "delete": null
  }
}