{
  "name": "ComplianceIssue",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string",
      "description": "Reference to Transaction"
    },
    "document_id": {
      "type": "string",
      "description": "Optional reference to Document"
    },
    "owner_user_id": {
      "type": "string",
      "description": "Owner of the parent transaction"
    },
    "brokerage_id": {
      "type": "string"
    },
    "issue_type": {
      "type": "string",
      "enum": [
        "signature",
        "missing_document",
        "deadline",
        "financial",
        "other"
      ],
      "default": "other"
    },
    "severity": {
      "type": "string",
      "enum": [
        "blocker",
        "warning",
        "info"
      ],
      "default": "warning"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved"
      ],
      "default": "open"
    },
    "source": {
      "type": "string",
      "enum": [
        "ai_scan",
        "deadline_check",
        "financial_check",
        "manual"
      ],
      "default": "ai_scan"
    },
    "suggested_task": {
      "type": "string"
    }
  },
  "required": [
    "transaction_id",
    "message"
  ],
  "rls": {
    "create": false,
    "read": null,
    "update": null,
    "delete": null
  }
}