{
  "name": "SignatureRecipient",
  "type": "object",
  "properties": {
    "signature_id": {
      "type": "string",
      "description": "Reference to SignatureRequest"
    },
    "transaction_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "buyer",
        "seller",
        "agent",
        "attorney",
        "lender",
        "title",
        "other"
      ],
      "default": "other"
    },
    "routing_order": {
      "type": "number",
      "default": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "viewed",
        "signed",
        "declined"
      ],
      "default": "pending"
    },
    "provider_signer_id": {
      "type": "string"
    },
    "signed_at": {
      "type": "string"
    },
    "viewed_at": {
      "type": "string"
    }
  },
  "required": [
    "signature_id",
    "name",
    "email"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "data.transaction_id": {
            "$in": [
              "{{user.data.accessible_transaction_ids}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "tc_lead",
                "tc"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.transaction_id": {
            "$in": [
              "{{user.data.editable_transaction_ids}}"
            ]
          }
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "tc_lead"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.transaction_id": {
            "$in": [
              "{{user.data.editable_transaction_ids}}"
            ]
          }
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "tc_lead"
              ]
            }
          }
        }
      ]
    }
  }
}