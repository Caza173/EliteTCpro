{
  "name": "SyncState",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Identifier for this sync state, e.g. 'googlecalendar'"
    },
    "sync_token": {
      "type": "string"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": false,
    "read": false,
    "update": false,
    "delete": false
  }
}