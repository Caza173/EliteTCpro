{
  "name": "SyncState",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Identifier for this sync state, e.g. 'googlecalendar'"
    },
    "sync_token": {
      "type": "string"
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "create": {
      "created_by": "system"
    },
    "read": {
      "created_by": "system"
    },
    "update": {
      "created_by": "system"
    },
    "delete": {
      "created_by": "system"
    }
  }
}