{
  "name": "TransactionContact",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string"
    },
    "contact_id": {
      "type": "string"
    },
    "owner_id": {
      "type": "string",
      "description": "User ID of the owner"
    },
    "role": {
      "type": "string",
      "enum": [
        "buyer",
        "seller",
        "agent",
        "lender",
        "title",
        "inspector",
        "attorney",
        "vendor",
        "tc",
        "other"
      ],
      "default": "other"
    },
    "is_primary": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "transaction_id",
    "contact_id"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.transaction_id": {
            "$in": [
              "{{user.data.accessible_tx_ids}}"
            ]
          }
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}",
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "tc_lead",
                "tc"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.transaction_id": {
            "$in": [
              "{{user.data.editable_tx_ids}}"
            ]
          }
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}",
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "tc_lead",
                "tc"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.transaction_id": {
            "$in": [
              "{{user.data.editable_tx_ids}}"
            ]
          }
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}",
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "tc_lead"
              ]
            }
          }
        }
      ]
    }
  }
}