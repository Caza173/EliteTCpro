{
  "name": "ComplianceReport",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string",
      "description": "Owner of the parent transaction"
    },
    "brokerage_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "document_name": {
      "type": "string"
    },
    "document_type": {
      "type": "string"
    },
    "page_count": {
      "type": "number"
    },
    "compliance_score": {
      "type": "number",
      "default": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "compliant",
        "warnings",
        "blockers"
      ],
      "default": "compliant"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "info_items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "all_issues": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extracted_fields": {
      "type": "object"
    },
    "signatures": {
      "type": "object"
    },
    "missing_initials_pages": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "blank_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_docs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "has_digital_signature": {
      "type": "boolean"
    },
    "digital_signature_platform": {
      "type": "string"
    }
  },
  "required": [
    "transaction_id"
  ],
  "rls": {
    "create": false,
    "read": null,
    "update": null,
    "delete": null
  }
}