{
  "name": "TransactionSummary",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string",
      "description": "Reference to Transaction"
    },
    "property_address": {
      "type": "string"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "buyer",
        "seller",
        "dual",
        "lease",
        "multifamily"
      ],
      "default": "buyer"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending",
        "closed",
        "cancelled"
      ],
      "default": "active"
    },
    "closing_date": {
      "type": "string",
      "format": "date"
    },
    "acceptance_date": {
      "type": "string",
      "format": "date"
    },
    "listing_agent_name": {
      "type": "string"
    },
    "buyer_agent_name": {
      "type": "string"
    },
    "purchase_price": {
      "type": "number"
    },
    "next_deadline_type": {
      "type": "string"
    },
    "next_deadline_date": {
      "type": "string",
      "format": "date"
    },
    "task_count_open": {
      "type": "number",
      "default": 0
    },
    "document_count": {
      "type": "number",
      "default": 0
    },
    "brokerage_id": {
      "type": "string"
    },
    "mls_number": {
      "type": "string"
    }
  },
  "required": [
    "transaction_id",
    "property_address"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner"
              ]
            }
          }
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        },
        {
          "data.transaction_id": {
            "$in": [
              "{{user.data.accessible_tx_ids}}"
            ]
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner"
              ]
            }
          }
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "owner"
          ]
        }
      }
    }
  }
}