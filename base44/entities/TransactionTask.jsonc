{
  "name": "TransactionTask",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string"
    },
    "brokerage_id": {
      "type": "string"
    },
    "phase": {
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "order_index": {
      "type": "number",
      "default": 0
    },
    "is_completed": {
      "type": "boolean",
      "default": false
    },
    "is_required": {
      "type": "boolean",
      "default": true
    },
    "is_custom": {
      "type": "boolean",
      "default": false
    },
    "created_by": {
      "type": "string"
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "description": "Date the task was marked complete (local NY date)"
    },
    "assigned_to_user_id": {
      "type": "string"
    },
    "assigned_to_email": {
      "type": "string"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "assigned_by_email": {
      "type": "string"
    },
    "completed_by_email": {
      "type": "string"
    },
    "completed_by_name": {
      "type": "string"
    },
    "last_updated_by_email": {
      "type": "string"
    }
  },
  "required": [
    "transaction_id",
    "phase",
    "title"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner"
              ]
            }
          }
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        },
        {
          "data.created_by": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner"
              ]
            }
          }
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        },
        {
          "data.created_by": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner"
              ]
            }
          }
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        },
        {
          "data.created_by": "{{user.id}}"
        }
      ]
    }
  }
}