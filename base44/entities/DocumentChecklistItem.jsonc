{
  "name": "DocumentChecklistItem",
  "type": "object",
  "properties": {
    "brokerage_id": {
      "type": "string"
    },
    "transaction_id": {
      "type": "string"
    },
    "doc_type": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "required": {
      "type": "boolean",
      "default": true
    },
    "required_by_phase": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "missing",
        "uploaded",
        "approved",
        "rejected"
      ],
      "default": "missing"
    },
    "uploaded_document_id": {
      "type": "string"
    },
    "reviewed_by_user_id": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "visible_to_client": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "transaction_id",
    "doc_type"
  ],
  "rls": {
    "create": {
      "data.brokerage_id": "{{user.data.brokerage_id}}",
      "$or": [
        {
          "created_by": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "tc_lead",
                "tc"
              ]
            }
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner"
              ]
            }
          }
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}",
          "user_condition": {
            "role": {
              "$in": [
                "tc_lead",
                "tc",
                "agent",
                "client"
              ]
            }
          }
        },
        {
          "data.transaction_id": {
            "$in": [
              "{{user.data.accessible_tx_ids}}"
            ]
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner"
              ]
            }
          }
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}",
          "user_condition": {
            "role": {
              "$in": [
                "tc_lead",
                "tc"
              ]
            }
          }
        },
        {
          "data.transaction_id": {
            "$in": [
              "{{user.data.editable_tx_ids}}"
            ]
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner"
              ]
            }
          }
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}",
          "user_condition": {
            "role": {
              "$in": [
                "tc_lead"
              ]
            }
          }
        }
      ]
    }
  }
}