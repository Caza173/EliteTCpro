{
  "name": "Contact",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "User ID of the owner"
    },
    "contact_type": {
      "type": "string",
      "enum": [
        "buyer",
        "seller",
        "agent",
        "lender",
        "title",
        "inspector",
        "attorney",
        "vendor",
        "tc",
        "other"
      ],
      "default": "other"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "mobile_phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "license_number": {
      "type": "string"
    },
    "brokerage_name": {
      "type": "string"
    },
    "street": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_favorite": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_used_date": {
      "type": "string",
      "format": "date"
    },
    "transaction_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "first_name",
    "last_name"
  ],
  "rls": {
    "create": {
      "data.owner_id": "{{user.id}}"
    },
    "read": {
      "data.owner_id": "{{user.id}}"
    },
    "update": {
      "data.owner_id": "{{user.id}}"
    },
    "delete": {
      "data.owner_id": "{{user.id}}"
    }
  }
}