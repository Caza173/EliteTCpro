{
  "name": "Agent",
  "type": "object",
  "properties": {
    "contact_id": {
      "type": "string",
      "description": "Reference to Contact"
    },
    "brokerage_id": {
      "type": "string",
      "description": "Reference to Brokerage"
    },
    "license_number": {
      "type": "string"
    },
    "agent_role": {
      "type": "string",
      "enum": [
        "listing_agent",
        "buyer_agent"
      ],
      "default": "buyer_agent"
    },
    "reference_code": {
      "type": "string",
      "description": "Unique agent reference code for secure portal access (e.g. AGT-XXXXXX)"
    }
  },
  "required": [
    "contact_id"
  ]
}