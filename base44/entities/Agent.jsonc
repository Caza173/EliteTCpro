{
  "name": "Agent",
  "type": "object",
  "properties": {
    "contact_id": {
      "type": "string",
      "description": "Reference to Contact"
    },
    "brokerage_id": {
      "type": "string",
      "description": "Reference to Brokerage"
    },
    "license_number": {
      "type": "string"
    },
    "agent_role": {
      "type": "string",
      "enum": [
        "listing_agent",
        "buyer_agent"
      ],
      "default": "buyer_agent"
    },
    "reference_code": {
      "type": "string",
      "description": "Unique agent reference code for secure portal access (e.g. AGT-XXXXXX)"
    }
  },
  "required": [
    "contact_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "tc_lead"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "tc_lead"
          }
        },
        {
          "user_condition": {
            "role": "tc"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "tc_lead"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "tc_lead"
          }
        }
      ]
    }
  }
}