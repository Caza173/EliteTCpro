{
  "name": "Team",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Team name"
    },
    "owner_id": {
      "type": "string",
      "description": "User ID of the platform owner who owns this team"
    },
    "brokerage_id": {
      "type": "string",
      "description": "Reference to Brokerage"
    },
    "created_by": {
      "type": "string",
      "description": "User ID of the creator"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "data.brokerage_id": "{{user.data.brokerage_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "owner"
          ]
        }
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner"
              ]
            }
          }
        },
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner"
              ]
            }
          }
        },
        {
          "data.owner_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "owner"
      }
    }
  }
}