{
  "name": "Contingency",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string",
      "description": "Owner of the parent transaction"
    },
    "brokerage_id": {
      "type": "string"
    },
    "contingency_type": {
      "type": "string",
      "enum": [
        "Inspection",
        "Financing",
        "Appraisal",
        "Title",
        "Due Diligence",
        "Other"
      ],
      "default": "Inspection"
    },
    "sub_type": {
      "type": "string",
      "description": "e.g. General Building, Septic, Conventional Financing"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "days_from_effective": {
      "type": "number"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "due_time": {
      "type": "string",
      "description": "Time of deadline (HH:MM)"
    },
    "is_all_day": {
      "type": "boolean",
      "default": true
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "scheduled_time": {
      "type": "string"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Scheduled",
        "Completed",
        "Waived",
        "Overdue"
      ],
      "default": "Pending"
    },
    "is_custom": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "Parsed",
        "Manual"
      ],
      "default": "Manual"
    }
  },
  "required": [
    "transaction_id",
    "contingency_type"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "super_admin"
              ]
            }
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "data.created_by": "{{user.id}}"
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "super_admin"
              ]
            }
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "data.created_by": "{{user.id}}"
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "super_admin"
              ]
            }
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "data.created_by": "{{user.id}}"
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        }
      ]
    }
  }
}