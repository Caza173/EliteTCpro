{
  "name": "CalendarEventMap",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string",
      "description": "Owner of the parent transaction"
    },
    "field_key": {
      "type": "string",
      "description": "e.g. inspection_deadline"
    },
    "calendar_event_id": {
      "type": "string"
    },
    "brokerage_id": {
      "type": "string"
    }
  },
  "required": [
    "transaction_id",
    "field_key",
    "calendar_event_id"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "super_admin"
              ]
            }
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "data.created_by": "{{user.id}}"
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "super_admin"
              ]
            }
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "data.created_by": "{{user.id}}"
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "super_admin"
              ]
            }
          }
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "data.created_by": "{{user.id}}"
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        }
      ]
    }
  }
}