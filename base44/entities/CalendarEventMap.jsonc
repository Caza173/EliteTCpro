{
  "name": "CalendarEventMap",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string",
      "description": "Owner of the parent transaction"
    },
    "field_key": {
      "type": "string",
      "description": "e.g. inspection_deadline"
    },
    "calendar_event_id": {
      "type": "string"
    },
    "brokerage_id": {
      "type": "string"
    }
  },
  "required": [
    "transaction_id",
    "field_key",
    "calendar_event_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "tc_lead",
                "tc"
              ]
            }
          }
        }
      ]
    },
    "read": null,
    "update": null,
    "delete": null
  }
}