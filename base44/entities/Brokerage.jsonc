{
  "name": "Brokerage",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Brokerage name"
    },
    "slug": {
      "type": "string",
      "description": "URL-safe identifier"
    },
    "primary_contact_name": {
      "type": "string"
    },
    "primary_contact_email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "timezone": {
      "type": "string",
      "default": "America/New_York"
    },
    "status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "suspended",
        "cancelled"
      ],
      "default": "trial"
    },
    "branding_logo": {
      "type": "string",
      "description": "Logo URL"
    },
    "branding_primary_color": {
      "type": "string",
      "default": "#3b82f6"
    },
    "email_from_name": {
      "type": "string"
    },
    "client_portal_enabled": {
      "type": "boolean",
      "default": true
    },
    "require_doc_approval": {
      "type": "boolean",
      "default": false
    },
    "default_template_id": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "owner"
          ]
        }
      }
    },
    "read": {
      "id": "{{user.data.brokerage_id}}"
    },
    "update": {
      "id": "{{user.data.brokerage_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "owner"
          ]
        }
      }
    },
    "delete": {
      "id": "{{user.data.brokerage_id}}",
      "user_condition": {
        "role": "owner"
      }
    }
  }
}