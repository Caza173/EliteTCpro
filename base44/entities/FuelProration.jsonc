{
  "name": "FuelProration",
  "type": "object",
  "properties": {
    "brokerage_id": {
      "type": "string"
    },
    "transaction_id": {
      "type": "string",
      "description": "Reference to Transaction"
    },
    "property_address": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "buyer_agent_name": {
      "type": "string"
    },
    "seller_agent_name": {
      "type": "string"
    },
    "closing_date": {
      "type": "string",
      "format": "date"
    },
    "agent_email": {
      "type": "string"
    },
    "title_company_email": {
      "type": "string"
    },
    "total_amount": {
      "type": "number",
      "default": 0
    },
    "total_gallons": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "sent"
      ],
      "default": "draft"
    },
    "pdf_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "tanks": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Embedded fuel tank proration details"
    }
  },
  "required": [
    "property_address"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}",
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "tc_lead",
                "tc"
              ]
            }
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}",
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "tc_lead",
                "tc"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}",
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "tc_lead",
                "tc"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}",
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "tc_lead"
              ]
            }
          }
        }
      ]
    }
  }
}