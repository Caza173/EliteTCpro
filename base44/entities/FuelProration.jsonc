{
  "name": "FuelProration",
  "type": "object",
  "properties": {
    "brokerage_id": {
      "type": "string"
    },
    "transaction_id": {
      "type": "string",
      "description": "Reference to Transaction"
    },
    "property_address": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "buyer_agent_name": {
      "type": "string"
    },
    "seller_agent_name": {
      "type": "string"
    },
    "closing_date": {
      "type": "string",
      "format": "date"
    },
    "agent_email": {
      "type": "string"
    },
    "title_company_email": {
      "type": "string"
    },
    "total_amount": {
      "type": "number",
      "default": 0
    },
    "total_gallons": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "sent"
      ],
      "default": "draft"
    },
    "pdf_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "tanks": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Embedded fuel tank proration details"
    }
  },
  "required": [
    "property_address"
  ],
  "rls": {
    "create": true,
    "read": {
      "data.brokerage_id": "{{user.data.brokerage_id}}"
    },
    "update": {
      "data.brokerage_id": "{{user.data.brokerage_id}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}