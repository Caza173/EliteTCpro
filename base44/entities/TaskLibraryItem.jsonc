{
  "name": "TaskLibraryItem",
  "type": "object",
  "properties": {
    "brokerage_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "phase": {
      "type": "number",
      "description": "Which phase this task belongs to (1-12), or null for any phase"
    },
    "is_required": {
      "type": "boolean",
      "default": false
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "data.brokerage_id": "{{user.data.brokerage_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "owner",
            "tc_lead"
          ]
        }
      }
    },
    "read": {
      "data.brokerage_id": "{{user.data.brokerage_id}}"
    },
    "update": {
      "data.brokerage_id": "{{user.data.brokerage_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "owner",
            "tc_lead"
          ]
        }
      }
    },
    "delete": {
      "data.brokerage_id": "{{user.data.brokerage_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "owner"
          ]
        }
      }
    }
  }
}