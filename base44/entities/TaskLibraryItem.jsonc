{
  "name": "TaskLibraryItem",
  "type": "object",
  "properties": {
    "brokerage_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "phase": {
      "type": "number",
      "description": "Which phase this task belongs to (1-12), or null for any phase"
    },
    "is_required": {
      "type": "boolean",
      "default": false
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "tc_lead"
              ]
            }
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        },
        {
          "data.is_system": true
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "tc_lead"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "tc_lead"
              ]
            }
          }
        }
      ]
    }
  }
}