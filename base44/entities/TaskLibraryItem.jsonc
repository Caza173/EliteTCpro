{
  "name": "TaskLibraryItem",
  "type": "object",
  "properties": {
    "brokerage_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "phase": {
      "type": "number",
      "description": "Which phase this task belongs to (1-12), or null for any phase"
    },
    "is_required": {
      "type": "boolean",
      "default": false
    },
    "created_by": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ]
}