{
  "name": "Appointment",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "User ID of the creator \u2014 used for RLS isolation"
    },
    "transaction_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "event_time": {
      "type": "string",
      "description": "HH:MM format (24h)"
    },
    "notes": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "google_calendar_synced": {
      "type": "boolean",
      "default": false
    },
    "google_calendar_event_id": {
      "type": "string"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "pending",
        "synced",
        "failed"
      ],
      "description": "Status of Google Calendar sync"
    }
  },
  "required": [
    "transaction_id",
    "title",
    "event_date"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}