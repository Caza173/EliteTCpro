{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string"
    },
    "created_by": {
      "type": "string",
      "description": "User ID who created the invoice"
    },
    "brokerage_id": {
      "type": "string"
    },
    "transaction_id": {
      "type": "string",
      "description": "Optional linked transaction"
    },
    "client_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "agent_name": {
      "type": "string"
    },
    "property_address": {
      "type": "string"
    },
    "transaction_side": {
      "type": "string",
      "enum": [
        "buyer",
        "seller",
        "both"
      ],
      "default": "buyer"
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "tax_rate": {
      "type": "number",
      "default": 0
    },
    "tax_amount": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "paid",
        "overdue",
        "cancelled"
      ],
      "default": "draft"
    },
    "sent_at": {
      "type": "string"
    },
    "paid_at": {
      "type": "string"
    }
  },
  "required": [
    "client_name",
    "client_email"
  ],
  "rls": {
    "create": {
      "data.brokerage_id": "{{user.data.brokerage_id}}",
      "created_by": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "tc_lead"
              ]
            }
          }
        },
        {
          "created_by": "{{user.id}}"
        },
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "data.brokerage_id": "{{user.data.brokerage_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "tc_lead"
              ]
            }
          }
        },
        {
          "created_by": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "owner",
                "tc_lead"
              ]
            }
          }
        },
        {
          "created_by": "{{user.id}}"
        }
      ]
    }
  }
}