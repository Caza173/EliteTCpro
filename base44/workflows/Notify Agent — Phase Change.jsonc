{
  "name": "Notify Agent \u2014 Phase Change",
  "description": "Emails the agent whenever a transaction's phase changes (e.g., Clear to Close, Closing, etc.)",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"transaction_phase\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Transaction"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_agent_phase_change",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyAgent",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyAgent"
  }
}