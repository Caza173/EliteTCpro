{
  "name": "Phase Completion Detection",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"is_completed\") != null) and (.trigger.data.is_completed == true)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "TransactionTask"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "phase_completion_detection",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "detectPhaseCompletion",
            "args": {
              "transaction_id": "{{event.data.transaction_id}}",
              "phase_number": "{{event.data.phase}}"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "detectPhaseCompletion"
  }
}