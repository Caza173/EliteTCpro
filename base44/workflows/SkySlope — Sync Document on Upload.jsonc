{
  "name": "SkySlope \u2014 Sync Document on Upload",
  "description": "Automatically uploads newly created EliteTC documents to the SkySlope compliance repository",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Document"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "skyslope_sync_document_on_upload",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "skySlopeSyncOnDocumentCreate",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "skySlopeSyncOnDocumentCreate"
  }
}