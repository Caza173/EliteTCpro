{
  "name": "Clear to Close Utility Draft Generation",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"is_completed\") != null) and (.trigger.data.is_completed == true) and (.trigger.data.title | index(\"clear to close\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "TransactionTask"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "clear_to_close_utility_draft_generation",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "handleClearToCloseCompletion",
            "args": {
              "transaction_id": "{{event.data.transaction_id}}"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "handleClearToCloseCompletion"
  }
}