{
  "name": "Deadline Engine \u2014 On Transaction Update",
  "description": "Re-evaluates deadlines for a transaction whenever its deadline fields change.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"inspection_deadline\") != null) or (.trigger.changed_fields | index(\"closing_date\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Transaction"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "deadline_engine_on_transaction_update",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "deadlineEngine",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "deadlineEngine"
  }
}