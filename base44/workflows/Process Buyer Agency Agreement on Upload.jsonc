    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "process_buyer_agency_agreement_on_upload",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onBuyerAgencyAgreementUpload",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onBuyerAgencyAgreementUpload"
  }
}