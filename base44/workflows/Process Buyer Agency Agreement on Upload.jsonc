{
  "name": "Process Buyer Agency Agreement on Upload",
  "description": "Automatically parse Buyer Agency Agreements when uploaded to extract Section 3 dates, create deadlines, set reminders, and sync to calendars.",
  "trigger": {
    "condition": "${ (.trigger.data.doc_type == \"buyer_agency_agreement\") }",
    "config": {
      "trigger_type": "entity",
