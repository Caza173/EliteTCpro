{
  "name": "Auto-stamp Agent Code on Transaction",
  "description": "Looks up the agent's reference_code by email and stamps allowed_agent_code on the transaction automatically.",
  "trigger": {
    "condition": "${ ((.trigger.data.buyers_agent_email != null) and (.trigger.data.allowed_agent_code != \"SKIP\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Transaction"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_stamp_agent_code_on_transaction",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "stampAgentCode",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "stampAgentCode"
  }
}